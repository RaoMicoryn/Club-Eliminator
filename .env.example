# Connection string dari Neon (Dashboard Neon -> Connect -> pilih "Pooled connection").
# Contoh: postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Password untuk masuk ke panel pengelola. Ganti dengan password kamu sendiri.
ADMIN_PASSWORD=

# String acak & rahasia, dipakai buat menandatangani session login admin.
# Isi bebas, minimal 20 karakter acak. Contoh generate: openssl rand -hex 32
ADMIN_SECRET=

# Path rahasia untuk panel pengelola, TANPA garis miring.
# Contoh: kelola-2026, panel-x7f9k2, dsb — jangan pakai "admin".
# Panel akan bisa diakses di: https://domainmu.com/<ADMIN_PATH>
ADMIN_PATH=
